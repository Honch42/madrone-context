{
  "name": "madronecontext",
  "version": "1.0.0",
  "description": "Interview-based context capture: a short spoken interview that turns your reasoning into Markdown notes for you and your AI tools.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js",
    "build": "electron-builder --mac"
  },
  "keywords": [],
  "author": "John Honchariw",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "electron-store": "^8.2.0",
    "express": "^5.2.1",
    "googleapis": "^178.1.1",
    "openai": "^7.15.0",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.madrone.context",
    "productName": "Madrone Context",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "extraResources": [
      "google_oauth_client*.json"
    ],
    "asarUnpack": [
      "node_modules/@modelcontextprotocol/server-filesystem/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Madrone Context records video during an interview so a model can compare what you say with how you say it.",
        "NSMicrophoneUsageDescription": "Madrone Context needs the microphone to hear your spoken answers."
      },
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "dmg": {
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
